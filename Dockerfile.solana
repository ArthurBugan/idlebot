# Solana + Anchor toolchain image for the IdleBot contract (Spec 012).
#
# The same image is used two ways via docker-compose:
#   * `solana`   service -> runs `solana-test-validator` (local RPC on :8899)
#   * `contract` service -> builds + runs `anchor test` against that validator
#
# Notes:
#   * Anchor is the `anchor-cli` crate (builds against modern openssl-sys 0.9,
#     works on OpenSSL 3.0). We do NOT use `avm` because it pulls ancient
#     openssl-sys 0.6.7 that fails on OpenSSL 1.1+/3.0 (opaque DH/X509).
#   * The solana-cli installer is invoked with `curl -fsSL` so a failed
#     download aborts the build (previously a silent no-op). It installs a
#     native binary for the host arch (x86_64 / aarch64).
#
# Build needs network access (solana-cli installer + crates.io).

FROM ubuntu:22.04

ENV DEBIAN_FRONTEND=noninteractive
RUN apt-get update && apt-get install -y --no-install-recommends \
        curl ca-certificates build-essential pkg-config libssl-dev \
        libudev-dev zlib1g-dev python3 \
    && rm -rf /var/lib/apt/lists/*

# Solana CLI: provides solana-test-validator + cargo-build-sbf.
# -fsSL makes curl fail on network/HTTP errors so the build does not
# silently continue without a solana toolchain.
RUN curl -fsSL https://release.solana.com/stable/install -o /tmp/solana-install.sh \
    && sh /tmp/solana-install.sh -y \
    && rm -f /tmp/solana-install.sh
ENV PATH="/root/.local/share/solana/install/active_release/bin:${PATH}"

# Rust toolchain (needed to build anchor-cli + the program).
RUN curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs \
        | sh -s -- -y --default-toolchain 1.79.0
ENV PATH="/root/.cargo/bin:${PATH}"

# Anchor 0.30.1 CLI (matches anchor-lang 0.30 used by the programs).
RUN cargo install anchor-cli --version 0.30.1 --locked

WORKDIR /code
COPY contracts/solana /code/contracts/solana

EXPOSE 8899 8900 8901

# Default command (used by the `solana` compose service): a fresh local
# validator. The `contract` service overrides this with the test runner.
CMD ["solana-test-validator", "--rpc-port", "8899", "--pubsub-port", "8900", \
     "--faucet-port", "8901", "--reset"]
